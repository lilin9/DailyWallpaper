<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:DailyWallpaper.ViewModels"
             xmlns:models="clr-namespace:DailyWallpaper.Models"
             x:Class="DailyWallpaper.Views.CategoriesPage"
             x:DataType="vm:CategoriesViewModel"
             Title="类别">
    <Grid Padding="16" RowDefinitions="Auto,Auto,*,Auto,Auto" RowSpacing="10">

        <!-- 添加自定义类别 -->
        <VerticalStackLayout Grid.Row="0" Spacing="6">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Entry Grid.Column="0"
                       Placeholder="输入自定义类别名称（最多 5 个字）"
                       MaxLength="5"
                       Text="{Binding NewCategoryName, Mode=TwoWay}" />
                <Button Grid.Column="1"
                        Text="添加"
                        Command="{Binding AddCommand}" />
            </Grid>
            <Label Text="默认类别只能勾选 / 取消，不能修改或删除；自定义类别可以删除。名称存在包含关系（如“动漫”与“日本动漫”）同样视为重复。"
                   FontSize="11"
                   TextColor="#888888" />
        </VerticalStackLayout>

        <!-- 计数与提示 -->
        <VerticalStackLayout Grid.Row="1" Spacing="4">
            <Label Text="{Binding CounterText}" FontSize="12" TextColor="#555555" />
            <Label Text="{Binding Message}" FontSize="13" TextColor="#2E7D32">
                <Label.Triggers>
                    <DataTrigger TargetType="Label" Binding="{Binding IsError}" Value="True">
                        <Setter Property="TextColor" Value="#C62828" />
                    </DataTrigger>
                </Label.Triggers>
            </Label>
        </VerticalStackLayout>

        <!-- 类别列表 -->
        <CollectionView Grid.Row="2" ItemsSource="{Binding Items}" SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:CategoryItem">
                    <Border Margin="0,4"
                            Padding="10"
                            Stroke="#E0E0E0"
                            StrokeShape="RoundRectangle 10">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
                            <CheckBox Grid.Column="0"
                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                      VerticalOptions="Center" />
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="{Binding Name}" FontSize="15" />
                                <Label Text="{Binding Keyword, StringFormat='搜索关键词：{0}'}"
                                       FontSize="11"
                                       TextColor="#888888" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2"
                                   Text="{Binding SourceLabel}"
                                   FontSize="11"
                                   TextColor="#888888"
                                   VerticalOptions="Center" />
                            <Button Grid.Column="3"
                                    Text="删除"
                                    FontSize="12"
                                    Padding="10,0"
                                    HeightRequest="34"
                                    BackgroundColor="#C62828"
                                    IsVisible="{Binding CanDelete}"
                                    Clicked="OnDeleteClicked" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- 操作按钮 -->
        <Grid Grid.Row="3" ColumnDefinitions="*,*" ColumnSpacing="10">
            <Button Grid.Column="0" Text="保存" Command="{Binding SaveCommand}" />
            <Button Grid.Column="1"
                    Text="重置壁纸类别选项"
                    BackgroundColor="#6E6E6E"
                    Command="{Binding ResetCommand}" />
        </Grid>

        <Label Grid.Row="4"
               FontSize="11"
               TextColor="#888888"
               LineBreakMode="CharacterWrap"
               Text="{Binding ConfigFilePath, StringFormat='类别关键词配置文件（可直接编辑后重启应用）：{0}'}" />
    </Grid>
</ContentPage>
