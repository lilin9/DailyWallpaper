<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- 优先目标平台：Android + Windows 11 -->
		<TargetFrameworks>net10.0-android</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>

		<OutputType>Exe</OutputType>
		<RootNamespace>DailyWallpaper</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<AndroidPackageFormat>apk</AndroidPackageFormat>

		<!-- XAML 源生成：编译期生成 C# 代码，避免运行时解析 XAML -->
		<MauiXamlInflator>SourceGen</MauiXamlInflator>

		<!-- 显示名称 -->
		<ApplicationTitle>DailyWallpaper</ApplicationTitle>

		<!-- 应用标识（Android 包名 / Windows 应用标识） -->
		<ApplicationId>com.dailywallpaper.app</ApplicationId>

		<!-- 版本 -->
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<!-- Windows：以非打包（unpackaged）方式运行，便于直接使用注册表开机自启与托盘常驻 -->
		<WindowsPackageType>MSIX</WindowsPackageType>

		<!-- Android 最低 API 24（Android 7.0），目标为 HyperOS 等新系统 -->
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>

		<!-- Windows 最低版本 -->
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
		<GenerateAppInstallerFile>True</GenerateAppInstallerFile>
		<AppxPackageSigningEnabled>True</AppxPackageSigningEnabled>
		<PackageCertificateThumbprint>54F656D64EDFA88970F5610941CD123A02CD50CB</PackageCertificateThumbprint>
		<AppxPackageSigningTimestampDigestAlgorithm>SHA256</AppxPackageSigningTimestampDigestAlgorithm>
		<AppxAutoIncrementPackageRevision>True</AppxAutoIncrementPackageRevision>
		<AppxSymbolPackageEnabled>False</AppxSymbolPackageEnabled>
		<GenerateTestArtifacts>False</GenerateTestArtifacts>
		<AppInstallerUri>C:\Users\lilin.DESKTOP-LILIN\Desktop</AppInstallerUri>
		<HoursBetweenUpdateChecks>0</HoursBetweenUpdateChecks>
	</PropertyGroup>

	<ItemGroup>
		<!-- 应用图标 -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" Color="#512BD4" />

		<!-- 启动画面 -->
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#512BD4" BaseSize="128,128" />

		<!-- 图片 -->
		<MauiImage Include="Resources\Images\*" />
		<MauiImage Update="Resources\Images\dotnet_bot.png" Resize="True" BaseSize="300,185" />

		<!-- 字体 -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- 原始资源：默认类别配置 categories.json 以 MauiAsset 形式随包分发 -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />

		<!-- MVVM 架构：ObservableObject / RelayCommand 源生成器 -->
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />

		<!-- IHttpClientFactory：统一配置超时、User-Agent -->
		<PackageReference Include="Microsoft.Extensions.Http" Version="10.0.0" />

		<!-- 图片处理：按屏幕比例缩放并居中裁剪 -->
		<PackageReference Include="SkiaSharp" Version="4.153.1" />
	</ItemGroup>

	<ItemGroup>
	  <MauiXaml Update="Views\HomePage.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Views\PermissionsPage.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	</ItemGroup>

</Project>